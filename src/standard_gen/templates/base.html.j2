<!DOCTYPE html>
{%- import 'macros.html.j2' as m %}
{%- set ogc = get_layout() == 'ogc' %}
{%- set md = doc.metadata %}
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ doc.metadata.doc_number }} — {{ doc.metadata.title }}</title>
  <link rel="stylesheet" href="ogc-standard.css">
  {%- if ogc %}
  <link rel="stylesheet" href="ogc-layout.css">
  {%- endif %}
</head>
<body data-status="{{ doc.metadata.status }}"{% if ogc %} class="layout-ogc"{% endif %}>
{%- set bp = doc.metadata.boilerplate %}
{%- macro notices() -%}
  <div class="boilerplate notices">
    {% for notice in bp.notices %}
    <div class="notice">
      <h2 class="notice-title">{{ notice.title }}</h2>
      {{ render_markdown(notice.text or '') | safe }}
    </div>
    {% endfor %}
  </div>
{%- endmacro %}

{# Cover #}
{%- if ogc %}
<header id="cover" class="ogc-cover">
  <p class="doc-stage">{{ md.status }}</p>
  <p class="doc-type">OGC {{ md.doc_type }}</p>
  <h1>{{ md.title }}</h1>
  {% if md.editors %}
  <p class="cover-editors">{% for ed in md.editors %}{{ ed.name }}{% if not loop.last %}, {% endif %}{% endfor %} <span class="role">Editor{% if md.editors | length > 1 %}s{% endif %}</span></p>
  {% endif %}
  <table class="cover-meta">
    {% if md.submission_date %}<tr><th>Submission Date</th><td>{{ md.submission_date }}</td></tr>{% endif %}
    {% if md.approval_date %}<tr><th>Approval Date</th><td>{{ md.approval_date }}</td></tr>{% endif %}
    {% if md.pub_date %}<tr><th>Publication Date</th><td>{{ md.pub_date }}</td></tr>{% endif %}
    {% if md.external_id %}<tr><th>External identifier of this OGC® document</th><td><a href="{{ md.external_id }}">{{ md.external_id }}</a></td></tr>{% endif %}
    {% if md.doc_number %}<tr><th>Internal identifier of this OGC® document</th><td>{{ md.doc_number }}</td></tr>{% endif %}
    {% if md.version %}<tr><th>Version</th><td>{{ md.version }}</td></tr>{% endif %}
    {% if md.doc_subtype %}<tr><th>Document subtype</th><td>{{ md.doc_subtype }}</td></tr>{% endif %}
  </table>
  {% if md.wg %}
  <p><strong>Working Group:</strong> {{ md.wg }}</p>
  {% endif %}
  {% if md.keywords and 'keywords' not in md.preface_autos %}
  <p><strong>Keywords:</strong> {{ md.keywords | join(', ') }}</p>
  {% endif %}
  {% if md.abstract and 'abstract' not in md.preface_autos %}
  <div class="doc-abstract">
    <strong>Abstract</strong>
    {{ render_markdown(md.abstract) | safe }}
  </div>
  {% endif %}
  {% if bp.get('notices') %}{{ notices() }}{% endif %}
</header>
{%- else %}
<header id="cover">
  <h1>{{ doc.metadata.title }}</h1>
  <div class="doc-meta">
    <span><strong>Document:</strong> {{ doc.metadata.doc_number }}</span>
    <span><strong>Type:</strong> {{ doc.metadata.doc_type }}</span>
    <span><strong>Status:</strong> {{ doc.metadata.status }}</span>
    <span><strong>Version:</strong> {{ doc.metadata.version }}</span>
    {% if doc.metadata.pub_date %}
    <span><strong>Date:</strong> {{ doc.metadata.pub_date }}</span>
    {% else %}
    <span><strong>Date:</strong> Draft</span>
    {% endif %}
  </div>
  {% if doc.metadata.editors %}
  <table class="editors-table">
    <tr><th>Editors</th><th>Affiliation</th></tr>
    {% for ed in doc.metadata.editors %}
    <tr><td>{{ ed.name }}</td><td>{{ ed.affiliation | default('') }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% if doc.metadata.wg %}
  <p><strong>Working Group:</strong> {{ doc.metadata.wg }}</p>
  {% endif %}
  {% if doc.metadata.keywords and 'keywords' not in md.preface_autos %}
  <p><strong>Keywords:</strong> {{ doc.metadata.keywords | join(', ') }}</p>
  {% endif %}
  {%- if 'abstract' not in md.preface_autos %}
  <div class="doc-abstract">
    <strong>Abstract</strong>
    <p>{{ doc.metadata.abstract }}</p>
  </div>
  {%- endif %}

  {# Boilerplate #}
  {%- if bp.get('notices') %}
  {{ notices() }}
  {%- else %}
  <div class="boilerplate">
    <p><strong>Copyright notice</strong><br>
    Copyright &copy; {{ bp.get('copyright-year', '') }} Open Geospatial Consortium.<br>
    To obtain additional rights of use, visit <a href="http://www.opengeospatial.org/legal/">http://www.opengeospatial.org/legal/</a>.</p>

    {% if bp.get('patent-policy') == 'OGC RF' %}
    <p><strong>Patent Policy Warning</strong><br>
    This document is not an OGC Standard. This document is distributed for review and comment.
    This document is subject to change without notice and may not be referred to as an OGC Standard.
    Recipients of this document are invited to submit, with their comments, notification of any
    relevant patent rights of which they are aware and to provide supporting documentation.
    The OGC Patent Policy is available at
    <a href="http://www.opengeospatial.org/ogc/patents">http://www.opengeospatial.org/ogc/patents</a>.</p>
    {% endif %}

    {% if bp.get('license') %}
    <p><strong>License Agreement</strong><br>
    Permission is hereby granted by the Open Geospatial Consortium, ("Licensor"), free of charge and
    subject to the terms of this Agreement, to any person obtaining a copy of this Intellectual
    Property and any associated documentation, to deal in the Intellectual Property without
    restriction (except as set forth below), including without limitation the rights to implement,
    use, copy, modify, merge, publish, distribute, and/or sublicense copies of the Intellectual
    Property, and to permit persons to whom the Intellectual Property is furnished to do so,
    provided that all copyright notices on the intellectual property are retained intact and that
    each person to whom the Intellectual Property is furnished agrees to the terms of this Agreement.</p>
    {% endif %}
  </div>
  {%- endif %}
</header>
{%- endif %}

{# Table of Contents #}
<nav id="toc">
  <h2>{% if ogc %}Contents{% else %}Table of Contents{% endif %}</h2>
  <ul>
    {% for section in doc.sections if section.depth == 0 %}
    <li>
      <a href="#{{ section.anchor }}">{{ section_title(section, true) }}</a>
      {% if section.subsections %}
      <ul>
        {% for sub in section.subsections %}
        <li{% if ogc %} class="toc-l{{ sub.level }}"{% endif %}><a href="#{{ sub.anchor }}">{% if sub.number %}{{ sub.number }}. {% endif %}{{ sub.title }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</nav>

<main>
{% for section in doc.sections %}
  {% set content = section.content %}
  {% set content_type = content.__class__.__name__ %}
  {%- set ctx = section_ctx(section) %}

  {# ---- Prose clause ---- #}
  {% if content_type == 'ProseClause' %}
  <section id="{{ section.anchor }}" {% if not content.normative %}class="informative"{% elif section.kind == 'preface' %}class="preface"{% endif %}>
    <h{{ section.level }}>{{ section_title(section) }}</h{{ section.level }}>
    {{ render_markdown(content.description_md, content.bblock_id, ctx) | safe }}
  </section>

  {# ---- Terms clause ---- #}
  {% elif content_type == 'TermsClause' %}
  <section id="{{ section.anchor }}">
    <h{{ section.level }}>{{ section_title(section) }}</h{{ section.level }}>
    {%- if ogc %}
    {{ render_markdown(terms_markdown(content), content.bblock_id, ctx) | safe }}
    {%- else %}
    {% if content.preamble_md %}{{ render_markdown(content.preamble_md, content.bblock_id) | safe }}{% endif %}
    {% for term in content.terms %}
    <div class="term-entry" id="term-{{ term.term | lower | replace(' ', '-') }}">
      <span class="term-name">{{ term.term }}</span>:
      {{ term.definition }}
      {% if term.sources %}
      <span class="term-source">
        [{% for src in term.sources %}<a href="{{ src.uri | default('#') }}">{{ src.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}]
      </span>
      {% endif %}
      {% if term.note %}<div class="editor-note">{{ term.note }}</div>{% endif %}
    </div>
    {% endfor %}
    {% if content.abbreviated_terms %}
    <div class="abbreviated-terms">
      <h3>Abbreviated Terms</h3>
      <table>
        {% for abbr, expansion in content.abbreviated_terms.items() | sort %}
        <tr><td><strong>{{ abbr }}</strong></td><td>{{ expansion }}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}
    {%- endif %}
  </section>

  {# ---- References clause ---- #}
  {% elif content_type == 'ReferencesClause' %}
  <section id="{{ section.anchor }}"{% if not content.normative and section.kind == 'annex' %} class="informative"{% endif %}>
    <h{{ section.level }}>{{ section_title(section) }}</h{{ section.level }}>
    {% if content.preamble_md %}{{ render_markdown(content.preamble_md, content.bblock_id, ctx) | safe }}{% endif %}
    {% for ref in (content.normative | sort(attribute='doc_id') if content.sort else content.normative) %}
    {%- if ref.citation %}
    <div class="reference-entry citation"{% if ref.anchor %} id="{{ ref.anchor }}"{% endif %}>{{ render_markdown(ref.citation, content.bblock_id) | safe }}</div>
    {%- else %}
    <div class="reference-entry"{% if ref.anchor %} id="{{ ref.anchor }}"{% endif %}>
      <span class="ref-id">{% if ref.doc_id %}{{ ref.doc_id }}{% endif %}</span>
      <span class="ref-body">
        {% if ref.uri %}<a href="{{ ref.uri }}">{{ ref.title }}</a>{% else %}{{ ref.title }}{% endif %}
        {% if ref.date %} ({{ ref.date }}){% endif %}
      </span>
    </div>
    {%- endif %}
    {% endfor %}
    {% if content.informative %}
    {%- if content.normative or not ogc %}
    <h3>Bibliography</h3>
    {%- endif %}
    {% for ref in content.informative %}
    {%- if ref.citation %}
    <div class="reference-entry citation"{% if ref.anchor %} id="{{ ref.anchor }}"{% endif %}>{{ render_markdown(ref.citation, content.bblock_id) | safe }}</div>
    {%- else %}
    <div class="reference-entry"{% if ref.anchor %} id="{{ ref.anchor }}"{% endif %}>
      <span class="ref-id">{% if ref.doc_id %}{{ ref.doc_id }}{% endif %}</span>
      <span class="ref-body">
        {% if ref.uri %}<a href="{{ ref.uri }}">{{ ref.title }}</a>{% else %}{{ ref.title }}{% endif %}
        {% if ref.date %} ({{ ref.date }}){% endif %}
      </span>
    </div>
    {%- endif %}
    {% endfor %}
    {% endif %}
  </section>

  {# ---- Conformance clause ---- #}
  {% elif content_type == 'ConformanceClause' %}
  <section id="{{ section.anchor }}">
    <h{{ section.level }}>{{ section_title(section) }}</h{{ section.level }}>
    <p>
      This standard defines the following requirements classes and their associated
      conformance classes. Conformance with this standard shall be checked using the
      tests specified in Annex A (normative).
    </p>
    <table class="conformance-table">
      <tr>
        <th>Conformance class</th>
        <th>Standardization target</th>
        <th>URI</th>
      </tr>
      {% for rc in content.req_classes %}
      <tr>
        <td>{{ rc.name }}</td>
        <td>{{ rc.standardization_target }}</td>
        <td><a href="{{ rc.conf_class_uri }}">{{ rc.conf_class_uri }}</a></td>
      </tr>
      {% endfor %}
    </table>
  </section>

  {# ---- Requirements class ---- #}
  {% elif content_type == 'ReqClass' %}
  <section id="{{ section.anchor }}" class="requirements-class">
    <h{{ section.level }}>{{ section_title(section) }}</h{{ section.level }}>
    {#- Rendered first: it places the class table and the statements that have a marker in it #}
    {%- set intro = render_markdown(content.description_md | split_intro, content.bblock_id, ctx) %}

    {# Requirements class table, unless placed by a <!-- requirements-class --> marker #}
    {%- if not has_placement(content.description_md, 'requirements-class') %}
    {{ m.req_class_box(content, ctx) }}
    {%- endif %}

    {# Intro prose (before <!-- requirements --> marker) #}
    {{ intro | safe }}

    {# Requirements heading — resets visual scope after any intro subheadings #}
    {% if content.unplaced %}
    {{ ctx.heading(ctx.level + 1, 'Requirements', 'req-' ~ section.anchor ~ '-requirements') | safe }}
    {% endif %}

    {# Statements not placed by a marker #}
    {% for req in content.unplaced %}
    {{ m.statement(req, content, ctx) }}
    {% endfor %}

    {# Outro prose (after <!-- requirements --> marker) #}
    {{ render_markdown(content.description_md | split_outro, content.bblock_id, ctx) | safe }}

    {# Examples #}
    {% if content.examples %}
    <div class="examples-section">
      <h3>Examples</h3>
      {% for example in content.examples %}
      <div class="example">
        <h4 class="example-title">{{ example.title or 'Example' }}</h4>
        {% if example.content %}{{ render_markdown(example.content, example.source_bblock_id or content.bblock_id) | safe }}{% endif %}
        {% for snippet in example.snippets %}
        <pre><code class="language-{{ snippet.language }}">{{ snippet.code | e }}</code></pre>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  {# ---- Annex A, explicit abstract tests ---- #}
  {% elif content_type == 'AnnexA' and content.explicit %}
  <section id="{{ section.anchor }}" class="{% if ogc %}annex-section{% else %}annex{% endif %} normative">
    <h{{ section.level }}>{{ section_title(section) }}</h{{ section.level }}>
    {{ render_markdown(content.description_md, content.bblock_id, ctx) | safe }}
    {% for rc in content.unplaced_classes %}
    {{ m.conf_class(rc, ctx) }}
    {% for t in content.unplaced_tests.get(rc.bblock_id, []) %}
    {{ m.abstract_test(t, ctx) }}
    {% endfor %}
    {% endfor %}
    {% for t in content.unplaced_tests.get(None, []) %}
    {{ m.abstract_test(t, ctx) }}
    {% endfor %}
  </section>

  {# ---- Annex A ---- #}
  {% elif content_type == 'AnnexA' %}
  <section id="{{ section.anchor }}" class="{% if ogc %}annex-section{% else %}annex{% endif %} normative">
    <h{{ section.level }}>{{ section_title(section) }}</h{{ section.level }}>
    {% for entry in content.entries %}
    <div class="ats-entry" id="ats-{{ entry.req_id_slug }}">
      <div class="ats-header">{{ entry.uri }}</div>
      <table>
        <tr>
          <td>Requirement</td>
          <td><a href="#req-{{ entry.req_id_slug }}">{{ entry.req_uri }}</a></td>
        </tr>
        <tr>
          <td>Test purpose</td>
          <td>{{ render_markdown(entry.test_purpose, entry.bblock_id) | safe }}</td>
        </tr>
        {% if entry.test_resources %}
        <tr>
          <td>Test method</td>
          <td>
            {% set method = entry.test_resources[0].method %}
            {% if method %}{{ render_markdown(method) | safe }}{% else %}<p>Inspect the response.</p>{% endif %}
          </td>
        </tr>
        <tr>
          <td>Test resources</td>
          <td>
            {% for tr in entry.test_resources %}
            <a class="test-resource {% if tr.require_fail %}require-fail{% endif %}"
               href="{{ tr.url }}">{{ tr.url | basename }}</a>
            {% endfor %}
          </td>
        </tr>
        {% endif %}
      </table>
    </div>
    {% endfor %}
  </section>

  {% endif %}
{% endfor %}
</main>

<footer>
  <p>
    {{ doc.metadata.boilerplate.get('copyright-year', '') }}
    Open Geospatial Consortium —
    {{ doc.metadata.doc_number }}
    {% if doc.metadata.boilerplate.get('license') %} — {{ doc.metadata.boilerplate.license }}{% endif %}
  </p>
  <p>Generated by <strong>bblocks-specgen</strong></p>
</footer>

</body>
</html>
